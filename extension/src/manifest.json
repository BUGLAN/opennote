{
  "manifest_version": 3,
  "name": "Opennote 剪藏",
  "version": "0.1.4",
  "description": "把网页上选中的片段或整页正文剪藏到本机的 Opennote 笔记本。",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "剪藏到 Opennote",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "permissions": [
    "storage",
    "contextMenus",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "http://127.0.0.1:8787/*",
    "http://127.0.0.1:8788/*",
    "http://127.0.0.1:8789/*",
    "http://127.0.0.1:8790/*",
    "http://127.0.0.1:8791/*",
    "http://127.0.0.1:8792/*",
    "http://127.0.0.1:8793/*",
    "http://127.0.0.1:8794/*",
    "http://127.0.0.1:8795/*",
    "http://127.0.0.1:8796/*"
  ],
  "commands": {
    "_execute_action": {
      "description": "打开剪藏弹窗"
    },
    "pick-element": {
      "suggested_key": {
        "default": "Alt+Shift+S"
      },
      "description": "进入元素选择模式（在页面上点一下要剪的部分）"
    },
    "clip-page": {
      "description": "剪藏整页正文到 Opennote"
    }
  }
}
