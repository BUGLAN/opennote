{
  "//": "服务端（`docs/执行-三端同步-密钥即身份-2026-10-13.md` §4.1、§5.6①）。",
  "//lib": "`lib: [\"ES2022\"]` + `types: [\"node\"]` —— **没有 DOM**。",
  "//lib2": "于是服务端代码里写 `window` / `document` 直接编译不过；",
  "//lib3": "它与 `shared/`（无 DOM 也无 node）共同把两侧边界机械化了。",
  "//strict": "严格档照抄客户端已有开关（strict / noUnusedLocals / verbatimModuleSyntax / isolatedModules），别放松。",
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": ["node"],
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true,
    "exactOptionalPropertyTypes": false,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "useDefineForClassFields": true,
    "noEmit": true
  },
  "include": ["src/**/*.ts", "../shared/**/*.ts"]
}
