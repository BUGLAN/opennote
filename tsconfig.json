{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "types": ["vite/client"],
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true,
    "exactOptionalPropertyTypes": false,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": false,
    "noEmit": true,
    "resolveJsonModule": true,
    "useDefineForClassFields": true
  },
  "include": [
    "src",
    "shared",
    "capacitor.config.ts",
    "vite.config.ts",
    "vitest.config.ts",
    "vite.clip.config.ts"
  ],
  "//exclude": "src/sw.ts 跑在 ServiceWorkerGlobalScope 里，需要 lib: WebWorker；与 DOM 同时开启会让 self/fetch/caches 变成两套类型。所以单独一份 tsconfig.sw.json（pnpm typecheck:sw）。",
  "exclude": ["src/sw.ts"]
}
