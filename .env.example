# ============================================================================
# 部署环境变量（`docs/执行-三端同步-密钥即身份-2026-10-13.md` §8.1、§7.3）
#
# 复制成 `.env` 再改：cp .env.example .env
#
# ★ `.env` **绝不能进 git**（已在 .gitignore 里）。它装着 CouchDB 管理口令与隧道 token，
#   泄露它 = 有人能直接读写所有笔记本的数据库。
#
# ★ 本文件里**没有**、也永远不会有「服务端密钥」这类配置 ——
#   因为按设计服务端**不持有任何密钥**（红线 3）。看到这样的项就是不认识这套设计。
# ============================================================================

# ---------------------------------------------------------------- 公开地址
# 客户端/控制台对着它拼 URL，也是日志与文档里引用的地址。
# 换入口（隧道厂商 / 反代）时改这一项即可 —— 代码里没有绑定任何厂商。
EXTERNAL_BASE_URL=https://notes.example.com

# 协议版本自检：与 `shared/contract.ts` 的 `PROTOCOL_VERSION` 不一致就**拒绝启动**。
# 这条能挡住「镜像里的服务端比自己以为的旧」这类最容易搞错的部署事故。
PROTOCOL_VERSION_EXPECTED=1

# ---------------------------------------------------------------- CouchDB
COUCH_URL=http://couchdb:5984

# 管理账号：**只在建库 / 置备 `_design` 时用**。首启时 compose 也用它建 Admin Party 之外的账号。
COUCH_ADMIN_USER=admin
COUCH_ADMIN_PASSWORD=改成一串长随机口令

# 运行时专用账号：**不是 admin**（§7.3 第 2 条）。它只有各笔记本库的成员权限。
# 缩小影响面：即使这个口令泄露，也删不掉别人的库、改不了 `_design`。
COUCH_SYNC_USER=sync-service
COUCH_SYNC_PASSWORD=再改成一串长随机口令

# ---------------------------------------------------------------- 限额
# 32 MB：受「边缘 30s 写超时」约束的那个上限（§3.5）。base64 后约 42.7 MB，
# 所以 CouchDB 的 `max_http_request_size` 要留到 48 MB（见 etc/couchdb/local.ini）。
MAX_FILE_BYTES=33554432
DEFAULT_ACCOUNT_QUOTA_BYTES=2147483648
DEFAULT_ACCOUNT_QUOTA_NOTEBOOKS=100

# ---------------------------------------------------------------- 入口相关
# 不绑定任何厂商：换入口就改这三项。
# 心跳**必须**小于边缘的读超时，否则连接会被边缘掐断而客户端看不出原因。
SSE_HEARTBEAT_MS=25000

# 可信代理头，逗号分隔。**默认空 = 谁都不信**（不进这层的头部，服务端只信 socket 对端地址）。
# ⚠️ 别随便填：按一个可伪造的头分桶 = 给攻击者一个「换头就换桶」的开关（§4.11、U19）。
# 用 Cloudflare 命名隧道时填 `cf-connecting-ip`。
# ⚠️ 客户端**直连** `:8787`（不经过边缘）时这个头根本不存在 —— 那时按 socket 地址分桶，
#    所以留空是安全的；留空**不会**让所有客户端挤进同一个桶（2026-10-22 修）。
TRUSTED_PROXY_HEADERS=

# sync 在宿主机上的回环端口（默认 8787）。本机同跑桌面客户端时，
# 客户端自带的本地桥也占 8787，这种场景改成本地不冲突的端口（如 18787），
# 客户端的服务地址随之带上该端口。
SYNC_HOST_PORT=8787

# 限流（令牌桶）：`perMinute` 是长期平均速率，`BURST` 是允许的突发量。
# ⚠️ 协议是「**一篇笔记 = 一个请求**」：120/分钟 = 2 篇/秒，一次换设备要 500 篇
#    就是 4 分钟（而且客户端会按 Retry-After 干等）。1200/分钟 ≈ 20 篇/秒。
#    客户端的限速器默认 12 请求/秒，正常同步不会撞到这里的账号桶。
ACCOUNT_REQUESTS_PER_MINUTE=1200
ACCOUNT_BURST=120
ACCOUNT_SSE_CONNECTIONS=4
# 全局兜底（每个对端 IP）：只防 DoS，不是防爆破。
GLOBAL_REQUESTS_PER_MINUTE=6000
GLOBAL_BURST=600
LOG_LEVEL=info

# ---------------------------------------------------------------- 隧道
# ★ 隧道跑在**宿主机**上（systemd：`cloudflared service install <token>`），
#   compose 里没有 tunnel 容器 —— sync 只绑宿主回环 127.0.0.1:8787 给它转发。
#   所以这个文件里**没有** TUNNEL_TOKEN：token 属于宿主机的 cloudflared，与应用配置无关。
#
# ★ 必须是**命名隧道**，不是 Quick Tunnel：Quick Tunnel 的域名每次重启都变，
#   而 E2EE 的信任根之一就是「用户核对地址」，一个会变的地址让那件事没法做。
