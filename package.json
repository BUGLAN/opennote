{
  "name": "opennote",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A pure-frontend, Typora-flavoured Markdown notebook that lives entirely in your browser.",
  "license": "MIT",
  "keywords": [
    "notes",
    "markdown",
    "notebook",
    "typora",
    "codemirror",
    "indexeddb",
    "pwa",
    "offline",
    "笔记"
  ],
  "homepage": "https://github.com/opennote/opennote#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/opennote/opennote.git"
  },
  "engines": {
    "node": ">=20.19",
    "pnpm": ">=9"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "icons": "python scripts/make_icons.py"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.12.4",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.13",
    "@fontsource-variable/figtree": "^5.3.0",
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/newsreader": "^5.3.0",
    "@lezer/common": "^1.5.3",
    "@lezer/highlight": "^1.2.4",
    "@lezer/markdown": "^1.7.2",
    "dompurify": "^3.4.16",
    "idb": "^8.0.3",
    "jszip": "^3.10.2",
    "katex": "^0.18.9",
    "markdown-it": "^15.0.2",
    "mermaid": "^12.0.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.0.2"
  }
}
